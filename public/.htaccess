# Version-controlled replacement for whatever .htaccess has been manually sitting on the
# Hostinger server up to now (that file was never tracked in this repo, so it couldn't be audited
# or deployed consistently). Vite copies everything in public/ verbatim into dist/, so this ships
# with every FTP deploy from now on.
#
# Confirmed root cause of a multi-day employee-invitation-link investigation: index.html has no
# content hash in its filename (unlike dist/assets/index-[hash].js/css, which Vite guarantees
# changes hash whenever its content changes), so it was the one file Apache's default static-file
# caching could serve stale indefinitely. A browser that had ever loaded index.html before a given
# deploy kept citing an old, deleted JS bundle by its old hashed filename — no amount of fixing the
# actual routing/link code mattered, because the browser never even fetched the page that contained
# the fix. The fix: index.html must always revalidate; the hashed JS/CSS it references are safe to
# cache aggressively forever, specifically because a content change always produces a new filename.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files/directories (assets, fonts, etc.) directly — only an unmatched path falls
  # through to the catch-all below for the SPA's own client-side routing. This check MUST stay
  # before the catch-all: the catch-all's pattern matches literally any request, so if it ran
  # first, every asset request (JS/CSS/fonts) would get rewritten to index.html too. Deliberately
  # untouched by the no-cache flag below: JS/CSS/fonts must stay cached by LSCache too, exactly as
  # aggressively as the Cache-Control headers further down already tell any other cache to.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # This catch-all only actually fires for a non-existent SPA sub-route (e.g. a deep link) — a
  # direct request for "/" or "/index.html" matches the passthrough rule above instead (the file/
  # directory already exists) and never reaches this line. That asymmetry is fine: the mod_headers
  # Cache-Control/X-LiteSpeed-Cache-Control block further down is what gives index.html full,
  # routing-path-independent coverage (it matches on the FILE Apache ends up serving, not on which
  # rule got it there). The E=Cache-Control flag here is additional, partial-coverage
  # defense-in-depth for the one case this file CAN reach, using LSCache's own second, independent
  # cache-control surface: LiteSpeed's documented devguide (docs.litespeedtech.com/lscache/devguide/
  # controls/) describes RewriteRule-set `E=Cache-Control:<value>` environment variables as a
  # mechanism its cache engine inspects directly, separate from the ordinary HTTP Cache-Control
  # header a browser/CDN would read — relevant here because LSCache can apply its own caching
  # decisions on top of (not strictly bound by) standard Cache-Control semantics.
  RewriteRule . /index.html [L,E=Cache-Control:no-cache]
</IfModule>

<IfModule mod_headers.c>
  # index.html: never cache. This is the one file a stale copy of silently defeats every other fix
  # in the entire app, since it's what points the browser at which JS bundle to load in the first
  # place.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    # LiteSpeed-specific, and deliberately in addition to (not instead of) the standard
    # Cache-Control header above: LiteSpeed's own devguide documents X-LiteSpeed-Cache-Control as a
    # response header LSCache's engine reads directly, overriding any cache decision it would
    # otherwise make from the standard Cache-Control header — i.e. it's possible for LSCache to
    # still cache a response whose Cache-Control header says not to, unless this header is also
    # present. This is the confirmed, documented reason a manual "Purge All" didn't fix staleness:
    # the standard header alone was never guaranteed to stop LSCache from re-caching index.html on
    # its own next crawl/request after a purge.
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>

  # Vite-built JS/CSS are the only .js/.css files this app ships (confirmed: nothing under
  # public/ is a .js or .css file) — every one of them carries a content hash in its filename, so
  # caching them forever is safe BY CONSTRUCTION: a content change always produces a new filename,
  # never a same-named file with different content.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts are checked into public/fonts/ with fixed, non-hashed filenames — a moderate cache, not
  # "immutable", so replacing one someday doesn't repeat today's exact failure mode.
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
